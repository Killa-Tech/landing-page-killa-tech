		description:
			"Plataforrma de gestión de eventos masivos, acreditaciones y mapas interactivos para exposiciones y congresos tecnológicos.",
		tags: ["NodeJs", "TailwindCSS", "React", "TypeScript"],
		stars: "142",
		forks: "38",
		version: "v1.4.1",
		icon: "🔍",
	},
	{
		status: "ACTIVE COMMUNITY",
		title: "Killa-cv",
		repo: "killa-tech / killa-cv",
		description:
			"Generador de CVs y portafolios profesionales en línea, con plantillas personalizables y despliegue instantáneo en GitHub Pages.",
		tags: ["TypeScript","Typst","Python","CSS","Makefile","HTML"],
		stars: "328",
		forks: "84",
		version: "v1.0.8",
		icon: "📝",
	},
	{
		status: "ACTIVE COMMUNITY",
		title: "Unju-agenda",
		repo: "killa-tech / unju-agenda",
		description:
			"Sistema de gestión de agendas académicas y eventos universitarios, con integración a calendarios externos y notificaciones push.",
		tags: ["TypeScript", "CSS", "JavaScript"],
		stars: "95",
